rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isTeacher() {
      return isAuthenticated() && (request.auth.token.teacher == true || isAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Questions collection: public question data readable by authenticated users, client writes allowed only for admins (custom claim)
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Question answers collection: protected correct answers and explanations. Strictly forbidden to students.
    match /question_answers/{questionId} {
      allow read, write: if isAdmin();
    }

    // Users collection: user profiles and educational associations
    match /users/{userId} {
      // Reading allowed for owner, admin, or teacher managing this student
      allow read: if isAuthenticated() && (
        isOwner(userId)
        || isAdmin()
        || (isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.teacherId == null))
      );

      // Creation allowed for owner, enforcing valid role constraints based on custom claims
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (
          (request.resource.data.role == 'student' && !request.auth.token.keys().hasAny(['admin', 'teacher']))
          || (request.resource.data.role == 'teacher' && isTeacher())
          || (request.resource.data.role == 'admin' && isAdmin())
        );

      // Updating allowed: role field is strictly immutable for client requests
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role)
        || isAdmin()
        || (isTeacher() && (resource.data.teacherId == request.auth.uid || resource.data.teacherId == null) && request.resource.data.role == resource.data.role)
      );

      allow delete: if isAdmin();
    }

    // Groups collection: manages classroom groups created by teachers
    match /groups/{groupId} {
      // Readable by teacher owner, enrolled students, or admins
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid
        || (resource.data.studentIds is list && request.auth.uid in resource.data.studentIds)
        || isAdmin()
      );

      // Creation allowed for teacher or admin
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.studentIds is list;

      // Update allowed only by the owning teacher or admin
      allow update: if isAuthenticated() && (
        (resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId)
        || isAdmin()
      ) && request.resource.data.studentIds is list;

      // Deletion allowed only by the owning teacher or admin
      allow delete: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid
        || isAdmin()
      );
    }

    // Test sessions collection: manages user test attempts
    match /test_sessions/{sessionId} {
      // Allow read to the authenticated session owner, admin, or the student's assigned teacher
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || (
          isTeacher()
          && exists(/databases/$(database)/documents/users/$(resource.data.userId))
          && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.teacherId == request.auth.uid
        )
      );

      // Allow creation only by the session owner with valid initial state and constraints
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() >= 1
        && request.resource.data.questionIds.size() <= 60
        && request.resource.data.durationLimitSec == 3600
        && request.resource.data.answers is map;

      // Allow updates only by the owner while in_progress, preserving immutable fields and enforcing allowed statuses
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.questionIds == resource.data.questionIds
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.durationLimitSec == resource.data.durationLimitSec
        && request.resource.data.status in ['in_progress', 'completed', 'abandoned'];

      // Client deletions are strictly denied
      allow delete: if false;
    }

    // Question exposure collection: tracks per-user question novelty and exposure history
    match /question_exposure/{userId} {
      // Allow read to the authenticated exposure owner, admin, or the student's assigned teacher
      allow read: if isAuthenticated() && (
        request.auth.uid == userId
        || isAdmin()
        || (
          isTeacher()
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.teacherId == request.auth.uid
        )
      );

      // Allow creation only by the authenticated owner with valid userId and questions map
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.questions is map;

      // Allow updates only by the authenticated owner with valid userId and questions map
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.questions is map;

      // Client deletions are strictly denied
      allow delete: if false;
    }

    // Exams collection: teacher-managed online exams
    match /exams/{examId} {
      // Reading allowed for owner teacher, admin, or students enrolled in the assigned group when exam is waiting/active/finished
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid
        || isAdmin()
        || (
          resource.data.status in ['waiting', 'active', 'finished']
          && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
          && (request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.studentIds)
        )
      );

      // Creation allowed only for teacher owner or admin
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.groupId is string
        && request.resource.data.questionIds is list
        && request.resource.data.status in ['draft', 'waiting', 'active'];

      // Updating allowed only for teacher owner or admin, preserving teacherId & groupId ownership and enforcing lifecycle rules
      allow update: if isAuthenticated() && (
        isAdmin()
        || (
          resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.groupId == resource.data.groupId
          && (resource.data.status != 'finished' || request.resource.data.status == 'finished')
          && (resource.data.status != 'active' || request.resource.data.status in ['active', 'finished'])
        )
      );

      // Deletion allowed for owner teacher only while in draft status, or admin
      allow delete: if isAuthenticated() && (
        (resource.data.teacherId == request.auth.uid && resource.data.status == 'draft')
        || isAdmin()
      );
    }

    // Exam PIN lookup collection: quick access by PIN for students enrolled in the exam's group
    match /exam_pin_lookup/{pin} {
      // Readable by teacher owner, admin, or students enrolled in the assigned group
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid
        || isAdmin()
        || (
          exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
          && (request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.studentIds)
        )
      );

      // Creation allowed only for teacher owner or admin
      allow create: if isTeacher()
        && (request.resource.data.teacherId == request.auth.uid || isAdmin());

      // Updating allowed only for teacher owner or admin, preserving teacherId
      allow update: if isAuthenticated() && (
        (resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId)
        || isAdmin()
      );

      // Deletion allowed only for teacher owner or admin
      allow delete: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid
        || isAdmin()
      );
    }

    // Exam sessions collection: student participation in online exams
    match /exam_sessions/{sessionId} {
      // Reading allowed for student owner, admin, or the teacher owning the exam
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid
        || isAdmin()
        || (
          isTeacher()
          && exists(/databases/$(database)/documents/exams/$(resource.data.examId))
          && get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.teacherId == request.auth.uid
        )
      );

      // Creation allowed only for enrolled students when exam is in waiting or active status, with no score tampering
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.groupId is string
        && request.resource.data.status in ['waiting', 'in_progress']
        && request.resource.data.answers is map
        && exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.status in ['waiting', 'active']
        && request.resource.data.groupId == get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.groupId
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && (request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.studentIds)
        && !request.resource.data.keys().hasAny(['score', 'totalScore', 'percentage', 'correctAnswersCount', 'maxPossibleScore', 'expiresAt', 'startedAt', 'questionOrder']);

      // Update allowed only by student owner while waiting or in_progress, preserving immutable fields and preventing score modification
      allow update: if isAuthenticated() && (
        isAdmin()
        || (
          resource.data.studentId == request.auth.uid
          && resource.data.status in ['waiting', 'in_progress']
          && (resource.data.status != 'in_progress' || request.resource.data.status in ['in_progress', 'submitted'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'flagged', 'currentIndex', 'status', 'updatedAt', 'submittedAt'])
        )
      );

      // Client deletions are strictly denied
      allow delete: if isAdmin();
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
