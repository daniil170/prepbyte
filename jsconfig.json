{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@app": ["src/app"],
      "@app/*": ["src/app/*"],
      "@features": ["src/features"],
      "@features/*": ["src/features/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"],
      "@infrastructure": ["src/infrastructure"],
      "@infrastructure/*": ["src/infrastructure/*"]
    }
  },
  "include": ["src"]
}
