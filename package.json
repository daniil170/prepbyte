{
  "name": "prepbyte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run src/infrastructure/firebase/firestoreRules.test.js'",
    "firebase:emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "firebase:seed": "node scripts/seed/seedEmulator.js",
    "firebase:sync-live": "node scripts/seed/syncLiveToEmulator.js",
    "seed": "node scripts/seed/seedQuestions.js",
    "bank:audit": "node scripts/audit/auditBank.js",
    "auth:set-admin": "node scripts/auth/setAdminClaim.js",
    "auth:set-teacher": "node scripts/auth/setTeacherClaim.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^12.19.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-admin": "^14.5.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
